# Copy this file to .env.local for local development (optional).
# On Vercel, set these under Project Settings -> Environment Variables.

# Admin login. Defaults to cmcparklift / CMC2026@ if not set.
ADMIN_USERNAME=cmcparklift
ADMIN_PASSWORD=CMC2026@

# Any long random string. Used to sign login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# These are auto-added by Vercel when you attach an "Upstash for Redis"
# storage integration from the Storage tab - you do not need to set them
# by hand. Listed here only so local dev can use the same backend if wanted.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
